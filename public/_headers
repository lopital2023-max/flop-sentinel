/*
  Content-Security-Policy: default-src 'self'; base-uri 'none'; connect-src 'self'; font-src 'self'; form-action 'none'; frame-ancestors 'none'; img-src 'self' data:; object-src 'none'; script-src 'self'; style-src 'self'; upgrade-insecure-requests
  Permissions-Policy: camera=(), geolocation=(), microphone=(), payment=(), usb=()
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

/status.json
  Cache-Control: no-cache, max-age=0, must-revalidate

/changes.json
  Cache-Control: no-cache, max-age=0, must-revalidate

/proof.json
  Cache-Control: no-cache, max-age=0, must-revalidate

/evidence/manifests/index.json
  Cache-Control: no-cache, max-age=0, must-revalidate

/evidence/attestations/index.json
  Cache-Control: no-cache, max-age=0, must-revalidate

/evidence/snapshots/*
  Content-Type: application/octet-stream
  Content-Disposition: attachment
  X-Content-Type-Options: nosniff
