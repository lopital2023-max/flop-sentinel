<!doctype html>
<!--
  GENERATED FILE - DO NOT EDIT BY HAND.
  Source: the .template.html + i18n/<locale>.json beside it
  Palette: DESIGN.md (substituted at build)
  Regenerate: python3 scripts/gen_flop_finance.py   (--check verifies sync)
-->
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>FLOP</title>
