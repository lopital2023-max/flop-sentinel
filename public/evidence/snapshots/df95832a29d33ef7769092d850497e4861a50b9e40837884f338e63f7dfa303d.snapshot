<meta name="twitter:site" content="@flop_labs" />

<link rel="canonical" href="https://flop.finance/" />
<link rel="alternate" hreflang="en" href="https://flop.finance/" />
<link rel="alternate" hreflang="zh" href="https://flop.finance/zh/" />
