---
import Layout from "../layouts/Layout.astro";
import { loadSiteData } from "../lib/site-data.mjs";

const { status, changes, trust } = await loadSiteData();
const availableCount = status.capabilities.filter((item) => item.state === "available").length;
const explicitUnavailableCount = status.capabilities.filter(
  (item) => item.state === "not-offered-current-service",
).length;
const pendingCount = status.capabilities.length - availableCount - explicitUnavailableCount;
const latestEvents = changes.events.slice(0, 4);
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const siteHref = (href) => `${base}${href.replace(/^\/+/, "")}`;
---

<Layout title="FLOP Sentinel — Evidence before action" current="home">
  <section class="hero">
    <div>
      <p class="eyebrow">
        EVIDENCE-FIRST FLOP INTELLIGENCE
      </p>
      <h1>Evidence before <em>action.</em></h1>
      <p class="hero-copy">
        An unofficial safety layer that checks FLOP URLs, claims, and contracts against pinned official sources and the currently published specification.
      </p>
      <div class="hero-actions">
        <a class="button primary" href={siteHref("/verify/")}>Verify a claim →</a>
        <a class="button" href={siteHref("/methodology/")}>Read the method</a>
      </div>
    </div>

    <aside class="observation-card" aria-label="Latest observation">
      <span class="micro-label"><span class="live-dot"></span>LATEST OBSERVATION</span>
      <strong><time data-iso={status.generatedAt}>{status.generatedAt}</time></strong>
      <p>Shown in Asia/Tokyo · four official sources observed</p>
    </aside>
  </section>

  <section class="section" aria-labelledby="readiness-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">READINESS REGISTER</p>
        <h2 id="readiness-title">What exists—and what cannot be claimed yet.</h2>
      </div>
      <p>“Not published” is kept separate from “does not exist,” with timestamps and evidence hashes on every state.</p>
    </div>

    <div class="metric-grid" aria-label="Capability summary">
      <div class="metric"><strong>{availableCount}</strong><span>confirmed available</span></div>
      <div class="metric"><strong>{explicitUnavailableCount}</strong><span>explicitly not offered</span></div>
      <div class="metric"><strong>{pendingCount}</strong><span>awaiting official publication</span></div>
    </div>

    <div class="capability-grid">
      {status.capabilities.map((item) => (
        <article class="capability-card" data-state={item.state}>
          <div class="state-icon" aria-hidden="true">
            {item.state === "available" ? "✓" : item.state === "not-offered-current-service" ? "—" : "?"}
          </div>
          <div>
            <h3>{item.label}</h3>
            <p>{item.detail}</p>
            <span class="status-code">{item.state}</span>
            {item.evidence[0] && (
              <a class="evidence-link" href={item.evidence[0].url} target="_blank" rel="noreferrer">
                evidence ↗
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="trust-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">PROVENANCE GRAPH</p>
        <h2 id="trust-title">Trust the path, not just the domain.</h2>
      </div>
      <p>Technocore rooms and notes live on an official domain but remain user-written. They are never promoted to official statements.</p>
    </div>

    <div class="trust-map">
      <div class="trust-hub">
        <div>
          <span>PINNED MODEL v{trust.version}</span>
          <strong>Trust anchors</strong>
        </div>
      </div>
      <div class="trust-nodes">
        {trust.roots.map((root) => (
          <div class="source-node">
            <span class="source-type">{root.trust}</span>
            <a href={root.url} target="_blank" rel="noreferrer">{root.url}</a>
          </div>
        ))}
        {trust.untrustedHostedZones.map((zone) => (
          <div class="source-node untrusted">
            <span class="source-type">USER-WRITABLE ZONE</span>
            <a href={`${zone.origin}${zone.pathPrefix}`} target="_blank" rel="noreferrer">
              {zone.origin}{zone.pathPrefix}*
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="changes-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">CHANGE SIGNAL</p>
        <h2 id="changes-title">Keep the moment the evidence moved.</h2>
      </div>
      <p>A changed hash is a review signal, not automatic proof of a new feature.</p>
    </div>

    {latestEvents.length > 0 ? (
      <ol class="timeline">
        {latestEvents.map((event) => (
          <li>
            <time data-iso={event.observedAt}>{event.observedAt}</time>
            <div>
              <h3>{event.sourceId}</h3>
              <p>{event.summary.join(" ")}</p>
              {event.sourceUrl && <a class="evidence-link" href={event.sourceUrl}>source ↗</a>}
            </div>
          </li>
        ))}
      </ol>
    ) : (
      <div class="empty-state">No change event has been recorded since the baseline.</div>
    )}
    <div class="hero-actions">
      <a class="button" href={siteHref("/changes/")}>Open the full timeline</a>
    </div>
  </section>

  <section class="section" aria-labelledby="contract-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">SAFETY CONTRACT</p>
        <h2 id="contract-title">No keys. No wallet. No remote scan.</h2>
      </div>
      <p>Checks stay in your browser. No submitted URL fetch, wallet connection, or analytics.</p>
    </div>
    <div class="principle-grid">
      <article class="principle"><span class="number">01</span><h3>Local-only</h3><p>Your input is checked locally against the published dataset.</p></article>
      <article class="principle"><span class="number">02</span><h3>Evidence-linked</h3><p>Every conclusion links back to a URL, timestamp, and SHA-256.</p></article>
      <article class="principle"><span class="number">03</span><h3>Conservative</h3><p>Unknown is not fraudulent, and an official domain is not unconditional trust.</p></article>
    </div>
  </section>
</Layout>
