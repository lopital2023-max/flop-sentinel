---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Verify — FLOP Sentinel"
  description="Check FLOP URLs, messages, and contract addresses locally against pinned evidence."
  current="verify"
>
  <header class="page-intro">
    <p class="eyebrow">LOCAL CLAIM ANALYZER</p>
    <h1>Paste it. Check it. See why.</h1>
    <p>Paste a URL, social post, claim instruction, or contract address. Neither the input nor its destinations leave this browser.</p>
  </header>

  <div class="verifier-layout">
    <div>
      <form id="verify-form" class="verify-panel" novalidate>
        <label for="claim-input">Content to verify</label>
        <textarea
          id="claim-input"
          name="claim"
          maxlength="20000"
          required
          spellcheck="false"
          placeholder="URL, social post, or 0x... address"
        ></textarea>
        <div class="form-meta">
          <span id="data-state"><span class="live-dot"></span>Loading evidence</span>
          <span><span id="character-count">0</span> / 20,000</span>
        </div>

        <div class="example-list" aria-label="Examples">
          <button type="button" data-example="https://flop.finance/">Official root</button>
          <button type="button" data-example="https://technocore.chat/r/lobby">User content</button>
          <button type="button" data-example="Claim FLOP at https://flop.finance.evil.example/claim">Lookalike domain</button>
          <button type="button" data-example="Technocore airdrop: enter your seed phrase to claim">Secret request</button>
        </div>

        <div class="verify-actions">
          <button id="analyze-button" class="button primary" type="submit" disabled>Run local check</button>
          <button id="clear-button" class="button" type="button">Clear</button>
        </div>
      </form>

      <aside class="privacy-panel">
        <strong>LOCAL-ONLY GUARANTEE</strong><br />
        This form has no submission endpoint. JavaScript reads same-origin `status.json` only and never fetches a submitted URL.
      </aside>
    </div>

    <section id="result-panel" class="result-panel" aria-live="polite" aria-atomic="false">
      <div id="result-placeholder" class="result-placeholder">
        <div>
          <p class="micro-label">AWAITING INPUT</p>
          <p>Your verdict and its evidence will appear here.</p>
        </div>
      </div>
      <div id="result-content" class="result-content" hidden>
        <div id="verdict-banner" class="verdict-banner">
          <span id="verdict-confidence" class="micro-label"></span>
          <h2 id="verdict-title"></h2>
        </div>
        <p id="verdict-summary" class="result-summary"></p>

        <div class="result-group">
          <h3 id="indicator-heading">Reasons</h3>
          <ul id="indicator-list" class="indicator-list"></ul>
        </div>
        <div id="url-group" class="result-group" hidden>
          <h3 id="url-heading">URLs</h3>
          <ul id="url-list" class="url-result-list"></ul>
        </div>
        <div id="evidence-group" class="result-group" hidden>
          <h3 id="evidence-heading">Evidence</h3>
          <ul id="evidence-list" class="evidence-list"></ul>
        </div>
        <div class="result-group">
          <h3 id="limitation-heading">Limits</h3>
          <ul id="limitation-list" class="limitation-list"></ul>
        </div>
        <div class="result-group">
          <p id="result-dataset" class="result-dataset"></p>
          <button id="copy-result" type="button" class="button">Copy JSON</button>
        </div>
      </div>
    </section>
  </div>

  <script>
    import "../web/verify-page.mjs";
  </script>
</Layout>
