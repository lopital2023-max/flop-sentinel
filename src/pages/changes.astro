---
import Layout from "../layouts/Layout.astro";
import { loadSiteData } from "../lib/site-data.mjs";

const { changes } = await loadSiteData();
---

<Layout
  title="Changes — FLOP Sentinel"
  description="A hash-backed timeline of monitored FLOP official-source changes."
  current="changes"
>
  <header class="page-intro">
    <p class="eyebrow">EVIDENCE TIMELINE</p>
    <h1>Record the change. Review the meaning.</h1>
    <p>We record when a normalized official-source hash changes. An event is a review signal—not automatic proof of a feature or announcement.</p>
  </header>

  <section class="section" aria-labelledby="timeline-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{changes.observationCount} OBSERVATIONS · {changes.eventCount} EVENTS</p>
        <h2 id="timeline-title">Public change history</h2>
      </div>
      <p>We do not republish monitored text or third-party input—only a summary, evidence URL, and SHA-256.</p>
    </div>

    {changes.events.length > 0 ? (
      <ol class="timeline">
        {changes.events.map((event) => (
          <li>
            <time data-iso={event.observedAt}>{event.observedAt}</time>
            <div>
              <span class="source-type">{event.severity} · {event.kind}</span>
              <h3>{event.sourceId}</h3>
              <p>{event.summary.join(" ")}</p>
              {event.sha256 && <p class="result-dataset">SHA-256 {event.sha256}</p>}
              {event.sourceUrl && (
                <a class="evidence-link" href={event.sourceUrl} target="_blank" rel="noreferrer">review source ↗</a>
              )}
            </div>
          </li>
        ))}
      </ol>
    ) : (
      <div class="empty-state">No change event has been recorded since the baseline.</div>
    )}
  </section>
</Layout>
