---
import Layout from "../layouts/Layout.astro";
import { loadSiteData } from "../lib/site-data.mjs";

const { status, trust } = await loadSiteData();
const verdicts = [
  ["VERIFIED_OFFICIAL_ROOT", "Exact match to a pinned official URL. It does not guarantee page content or future safety."],
  ["OFFICIALLY_REFERENCED", "Inside an official namespace or configured reference. Specific content still needs review."],
  ["UNVERIFIED", "Current evidence cannot establish official provenance. This is not an accusation of fraud."],
  ["CONFLICTS_WITH_CURRENT_OFFICIAL_STATE", "A claim explicitly conflicts with the currently observed specification."],
  ["HIGH_RISK_PATTERN", "Secret requests, user-info, lookalike domains, or another stop signal was detected."],
];
---

<Layout
  title="Method — FLOP Sentinel"
  description="How FLOP Sentinel classifies official sources, claims, and risk indicators."
  current="methodology"
>
  <header class="page-intro">
    <p class="eyebrow">OPEN DECISION MODEL</p>
    <h1>Publish the method, not just the verdict.</h1>
    <p>No opaque AI score or private blacklist—only pinned roots, deterministic rules, observation time, and evidence hashes.</p>
  </header>

  <div class="method-stack">
    <section class="method-card">
      <div>
        <p class="eyebrow">01 · COLLECT</p>
        <h2>Read pinned sources only</h2>
      </div>
      <div>
        <p>The collector accepts no arbitrary URL. It reads four sources pinned in both configuration and code, with redirects restricted to approved hosts.</p>
        <ul>
          {status.sources.map((source) => (
            <li><a href={source.url} target="_blank" rel="noreferrer">{source.id}</a> · <code>{source.sha256?.slice(0, 16)}…</code></li>
          ))}
        </ul>
      </div>
    </section>

    <section class="method-card">
      <div>
        <p class="eyebrow">02 · CLASSIFY</p>
        <h2>Separate origin from author</h2>
      </div>
      <div>
        <p>Being hosted on an official domain is not the same as being an official statement. These zones remain user content:</p>
        <ul>
          {trust.untrustedHostedZones.map((zone) => (
            <li><code>{zone.origin}{zone.pathPrefix}*</code> — {zone.reason}</li>
          ))}
        </ul>
      </div>
    </section>

    <section class="method-card">
      <div>
        <p class="eyebrow">03 · CHECK</p>
        <h2>Check deterministically in-browser</h2>
      </div>
      <div>
        <p>Without fetching submitted URLs, we inspect syntax, hostname, Punycode, user-info, ports, roots, secret requests, claim context, and published contracts.</p>
      </div>
    </section>

    <section class="method-card">
      <div>
        <p class="eyebrow">04 · EXPLAIN</p>
        <h2>Five evidence verdicts</h2>
      </div>
      <div>
        <table class="verdict-table">
          <thead><tr><th>Verdict</th><th>Meaning</th></tr></thead>
          <tbody>
            {verdicts.map(([code, meaning]) => (
              <tr>
                <td><code>{code}</code></td>
                <td>{meaning}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="method-card">
      <div>
        <p class="eyebrow">LIMITS</p>
        <h2>What this site cannot prove</h2>
      </div>
      <div>
        <ul>
          <li>Absolute safety of a site or smart contract</li>
          <li>Airdrop existence, allocation, or eligibility</li>
          <li>The identity or honesty of a DID author</li>
          <li>Official changes after the observation time</li>
          <li>Unpublished chain or wallet specifications</li>
        </ul>
      </div>
    </section>
  </div>
</Layout>
